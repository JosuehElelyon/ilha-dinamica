{
  "name": "ilha-dinamica",
  "productName": "Ilha Dinâmica",
  "version": "1.0.0",
  "description": "Dynamic Island para Windows — mídia, clipboard, foco, timer, notas, agenda e sistema",
  "main": "src/main.js",
  "author": "Josueh",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.josueh.ilhadinamica",
    "productName": "Ilha Dinâmica",
    "files": ["src/**/*", "scripts/**/*", "assets/**/*", "package.json"],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
